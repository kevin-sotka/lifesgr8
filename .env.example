# Copy to .env and fill in. .env is gitignored and must stay that way.
# Nothing in this project ever prints a token to logs or console.

# Yahoo Fantasy Sports API, from https://developer.yahoo.com/apps/
# The app needs "Fantasy Sports" under API Permissions, set to Read. Never
# Read/Write: this project makes GET requests and nothing else.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Use "oob" if Yahoo's app form accepts it (Yahoo then shows you a code).
# If the form insists on a URL, register https://localhost:8080 and put the
# same value here.
YAHOO_REDIRECT_URI=oob

# Tokens are not stored here. `./fantasy-api auth` writes them to
# data/.yahoo_tokens.json (gitignored, owner-only) and refreshes them after that.

# The league. Game key is resolved at runtime and is not set here.
LEAGUE_ID=

# Anthropic, for the Tuesday recap prose only.
ANTHROPIC_API_KEY=
